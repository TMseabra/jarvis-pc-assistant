# Provider do modelo: "ollama" (local, grátis) ou "gemini" (cloud, precisa de chave)
JARVIS_PROVIDER=ollama

# Ollama
# JARVIS_OLLAMA_MODEL=qwen2.5:7b   (ou qwen2.5-coder)
# OLLAMA_HOST=http://localhost:11434
# JARVIS_VISION_MODEL=qwen2.5vl:7b   (ver fotos no Telegram: ollama pull qwen2.5vl:7b)

# Gemini (chave grátis em https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# JARVIS_GEMINI_MODEL=gemini-3.8-flash

# Voz
# JARVIS_MIC=HyperX
# JARVIS_WHISPER_MODEL=large-v3-turbo
# JARVIS_WHISPER_DEVICE=auto
# JARVIS_TTS=edge
# JARVIS_TTS_VOICE=pt-PT-DuarteNeural
# JARVIS_VOICE_STYLE=normal   (ou jarvis)
# JARVIS_END_SILENCE=3
# JARVIS_MANUAL_SILENCE=15
# JARVIS_WAKE_THRESHOLD=0.3

# Telegram (configura com: Jarvis.bat --telegram)
# JARVIS_TELEGRAM_TOKEN=
# JARVIS_TELEGRAM_ALLOWED_IDS=

# Apps
# JARVIS_BROWSER=opera
# JARVIS_SPOTIFY_CLIENT_ID=
# JARVIS_MESSAGING=auto
# JARVIS_PROJECT_DIRS=C:\Users\eu\Documents\GitHub

# Outros
# JARVIS_MAX_TURNS=10
# JARVIS_LANGUAGE=pt-PT
# JARVIS_BROWSER_PROFILE=.jarvis/browser-profile
# JARVIS_CONFIRM_SEND=1
# JARVIS_CONFIRM_AI_REPLIES=1
